DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/surat_penawaran?schema=public"
# Set a long random secret. The verifier enters it through SweetAlert2; it is never stored by the frontend.
PAYMENT_VERIFICATION_TOKEN="replace-with-a-long-random-secret"
# Comma-separated frontend origins allowed to call this API. Set this to the deployed app origin in production.
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
# Secret key (min 16 characters) for signing session tokens. Required in production.
AUTH_SECRET="replace-with-at-least-16-random-characters"
# Administrator credentials for full access (including deletion and payment verification). Required in production (min 8-char password).
AUTH_ADMIN_USERNAME="admin"
AUTH_ADMIN_PASSWORD="replace-with-strong-admin-password"
# Optional staff credentials (can manage documents & record pending payments, but cannot delete or verify payments).
AUTH_STAFF_USERNAME="staff"
AUTH_STAFF_PASSWORD="replace-with-strong-staff-password"
# Integration tests require a separately provisioned disposable PostgreSQL database whose name ends in _test.
BILLING_TEST_DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/surat_penawaran_test?schema=public"
